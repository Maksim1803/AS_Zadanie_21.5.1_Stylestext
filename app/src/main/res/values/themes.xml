<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Zadanie2151_Stylestext" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
    </style>

    <style name="TextStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:shadowDy">10</item>
        <item name="android:shadowDx">10</item>
        <item name="android:shadowRadius">10</item>
        <item name="android:shadowColor">@android:color/black</item>
        <item name="backgroundTint">@android:color/holo_red_dark</item>
        <item name="android:textColor">@android:color/holo_orange_dark</item>
        <item name="android:textStyle">italic</item>
        <item name="android:textSize">35sp</item>
    </style>

    <style name="TextStyle2" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:shadowDy">20</item>
        <item name="android:shadowDx">20</item>
        <item name="android:shadowRadius">20</item>
        <item name="android:shadowColor">@android:color/black</item>
        <item name="backgroundTint">@android:color/holo_blue_dark</item>
        <item name="android:textColor">@android:color/holo_green_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">25sp</item>
    </style>

    <style name="Theme.Zadanie2151_Stylestext" parent="Base.Theme.Zadanie2151_Stylestext" />
</resources>